{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": [
    "packages/kit-ui-protocol/src", "packages/kit-host/src", "packages/kit-editor/src", "packages/kit-editor/browser", "packages/kit-dev-host/src",
    "packages/kdm/src", "packages/kdm/test", "packages/kdm/prototypes", "packages/kdm/bench",
    "packages/sync/src", "packages/sync/test", "packages/embed-server/src", "packages/embed-server/test", "packages/embed/src", "packages/embed/test",
    "packages/script/src", "packages/script/test", "packages/script/kits",
    "packages/extensions/src", "packages/extensions/test",
    "packages/kition/src", "packages/kition/test",
    "packages/gateway-page/src", "packages/gateway-page/test"
  ]
}
