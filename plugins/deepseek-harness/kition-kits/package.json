    "bin/kits-mcp.mjs",
    "lib/client.js",
    "lib/forward.mjs",
    "lib/freshness.mjs",
    "lib/gateways.mjs",
    "lib/host.mjs",
    "lib/kition.mjs",
    "lib/mcp.mjs",
