{
  "khp": "1.0",
  "id": "kit.table",
  "name": "Table",
  "version": "0.1.0",
  "formats": [
    {
      "id": "ktable",
      "extensions": [
        "ktable"
      ],
      "mime": "application/vnd.kition.table+sqlite3",
      "role": "edit"
    }
  ],
  "creates": [
    {
      "id": "table",
      "extension": "ktable",
      "baseName": "Untitled table"
    }
  ],
  "exports": [
    {
      "extension": "csv",
      "mime": "text/csv",
      "command": "table.file.export"
    },
    {
      "extension": "md",
      "mime": "text/markdown",
      "command": "table.file.export"
    }
  ],
  "capabilities": [
    "kdm"
  ],
  "agent": {
    "prefix": "table",
    "tools": "document",
    "drafts": false,
    "objectModel": true,
    "layout": false,
    "export": {
      "command": "table.file.export",
      "data": "data"
    },
    "describe": {
      "noun": "table file"
    }
  },
  "headless": {
    "executable": "kition-table",
    "protocol": "kition-kit/2",
    "features": [
      "view.describe",
      "document.check",
      "model.open",
      "model.import",
      "model.export",
      "model.save",
      "model.describe",
      "model.batch"
    ]
  }
}
