{
  "$comment": "The Kition SDK's one version and what its bundle holds (tools/sdk-bundle.mjs, docs/sdk/README.md). Bump the version, crates/kition-cli's version (kition --version) and add a CHANGELOG.md entry together.",
  "version": "0.4.0",
  "packages": ["@kition/embed", "@kition/script", "@kition/sync", "@kition/kdm", "@kition/embed-server"],
  "kits": ["html", "note", "table"],
  "binaries": {
    "service": { "name": "kition-kits", "env": "KITION_KITS", "version": 1 },
    "mcp": { "name": "kition-kits-mcp", "env": "KITION_KITS_MCP", "npm": "@kition/kits-mcp" },
    "kits": { "env": "KITION_KIT_<KIT>_BINARY", "name": "kition-<kit>" },
    "cli": { "name": "kition", "home": "KITION_HOME", "index": "KITION_INDEX", "defaultIndex": "https://github.com/KitionAI/kition-sdk/releases/latest/download/kits-index.json" }
  }
}
