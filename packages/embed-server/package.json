{
  "name": "@kition/embed-server",
  "version": "0.1.0",
  "description": "Serves Kition kit editors to iframes: opens a kit's editor for a URL carrying a signed open token and reads and writes the file through your server's signed HTTP callbacks.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./callbacks": "./src/callbacks.ts"
  },
  "bin": {
    "kition-embed-server": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../tools/build-package.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@kition/embed": "workspace:*",
    "@kition/sync": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KitionAI/kition-sdk.git",
    "directory": "packages/embed-server"
  },
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./callbacks": {
        "types": "./dist/callbacks.d.ts",
        "import": "./dist/callbacks.js"
      }
    }
  },
  "main": "./dist/index.js"
}
