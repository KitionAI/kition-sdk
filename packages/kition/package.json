{
  "name": "@kition/cli",
  "version": "0.5.2",
  "description": "Kition's command line from npm: `npm install -g @kition/cli` gives the `kition` command, and `npx -y @kition/cli mcp --workspace <folder>` serves the kits' tools to any agent over MCP. It downloads each published kit on first use.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "kition": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../tools/build-package.mjs",
    "prepack": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KitionAI/kition-sdk.git",
    "directory": "packages/kition"
  },
  "homepage": "https://github.com/KitionAI/kition-sdk/tree/main/packages/kition#readme",
  "bugs": {
    "url": "https://github.com/KitionAI/kition-sdk/issues"
  },
  "keywords": ["kition", "cli", "mcp", "model-context-protocol", "khp", "agent", "markdown"],
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "main": "./dist/index.js"
}
