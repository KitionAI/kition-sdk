{
  "name": "@kition/convergence",
  "version": "0.3.0",
  "description": "The Kition kit platform's convergence suite for TypeScript engines: the scenarios of kition-convergence, run against a contract 2 kit through a small adapter, with the same report.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@kition/kdm": "workspace:*",
    "@kition/kit-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KitionAI/kition-sdk.git",
    "directory": "packages/convergence"
  },
  "types": "./dist/types/src/index.d.ts",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/types/src/index.d.ts",
        "import": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/types/src/node.d.ts",
        "import": "./dist/node.js"
      }
    }
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "node ../../tools/build-package.mjs",
    "prepack": "pnpm run build"
  }
}
