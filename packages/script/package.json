{
  "name": "@kition/script",
  "version": "0.5.2",
  "description": "The Kition object model for scripts and extensions: typed proxies, load and sync() batching, commands, and change events over any contract 2 kit, in a page or in Node.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./proxy": "./src/proxy.ts",
    "./kits": "./kits/index.ts",
    "./kits/board": "./kits/board.ts",
    "./kits/cad": "./kits/cad.ts",
    "./kits/design": "./kits/design.ts",
    "./kits/doc": "./kits/doc.ts",
    "./kits/film": "./kits/film.ts",
    "./kits/html": "./kits/html.ts",
    "./kits/layout": "./kits/layout.ts",
    "./kits/motion": "./kits/motion.ts",
    "./kits/note": "./kits/note.ts",
    "./kits/pdf": "./kits/pdf.ts",
    "./kits/photo": "./kits/photo.ts",
    "./kits/scene": "./kits/scene.ts",
    "./kits/sheet": "./kits/sheet.ts",
    "./kits/slide": "./kits/slide.ts",
    "./kits/table": "./kits/table.ts",
    "./kits/vector": "./kits/vector.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../tools/build-package.mjs",
    "generate": "node scripts/generate-kit.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@kition/kdm": "workspace:*",
    "@kition/sync": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KitionAI/kition-sdk.git",
    "directory": "packages/script"
  },
  "types": "./dist/types/src/index.d.ts",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/types/src/index.d.ts",
        "import": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/types/src/node.d.ts",
        "import": "./dist/node.js"
      },
      "./proxy": {
        "types": "./dist/types/src/proxy.d.ts",
        "import": "./dist/proxy.js"
      },
      "./kits": {
        "types": "./dist/types/kits/index.d.ts",
        "import": "./dist/kits/index.js"
      },
      "./kits/board": {
        "types": "./dist/types/kits/board.d.ts",
        "import": "./dist/kits/board.js"
      },
      "./kits/cad": {
        "types": "./dist/types/kits/cad.d.ts",
        "import": "./dist/kits/cad.js"
      },
      "./kits/design": {
        "types": "./dist/types/kits/design.d.ts",
        "import": "./dist/kits/design.js"
      },
      "./kits/doc": {
        "types": "./dist/types/kits/doc.d.ts",
        "import": "./dist/kits/doc.js"
      },
      "./kits/film": {
        "types": "./dist/types/kits/film.d.ts",
        "import": "./dist/kits/film.js"
      },
      "./kits/html": {
        "types": "./dist/types/kits/html.d.ts",
        "import": "./dist/kits/html.js"
      },
      "./kits/layout": {
        "types": "./dist/types/kits/layout.d.ts",
        "import": "./dist/kits/layout.js"
      },
      "./kits/motion": {
        "types": "./dist/types/kits/motion.d.ts",
        "import": "./dist/kits/motion.js"
      },
      "./kits/note": {
        "types": "./dist/types/kits/note.d.ts",
        "import": "./dist/kits/note.js"
      },
      "./kits/pdf": {
        "types": "./dist/types/kits/pdf.d.ts",
        "import": "./dist/kits/pdf.js"
      },
      "./kits/photo": {
        "types": "./dist/types/kits/photo.d.ts",
        "import": "./dist/kits/photo.js"
      },
      "./kits/scene": {
        "types": "./dist/types/kits/scene.d.ts",
        "import": "./dist/kits/scene.js"
      },
      "./kits/sheet": {
        "types": "./dist/types/kits/sheet.d.ts",
        "import": "./dist/kits/sheet.js"
      },
      "./kits/slide": {
        "types": "./dist/types/kits/slide.d.ts",
        "import": "./dist/kits/slide.js"
      },
      "./kits/table": {
        "types": "./dist/types/kits/table.d.ts",
        "import": "./dist/kits/table.js"
      },
      "./kits/vector": {
        "types": "./dist/types/kits/vector.d.ts",
        "import": "./dist/kits/vector.js"
      }
    }
  },
  "main": "./dist/index.js"
}
