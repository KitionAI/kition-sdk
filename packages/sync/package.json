{
  "name": "@kition/sync",
  "version": "0.5.2",
  "description": "Client for the open sync protocol kition-sync/1: JSON-RPC 2.0 over WebSocket, reconnect with backoff, and an offline push queue.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./openToken": "./src/openToken.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../tools/build-package.mjs",
    "prepack": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KitionAI/kition-sdk.git",
    "directory": "packages/sync"
  },
  "homepage": "https://github.com/KitionAI/kition-sdk/tree/main/packages/sync#readme",
  "bugs": {
    "url": "https://github.com/KitionAI/kition-sdk/issues"
  },
  "keywords": [
    "kition",
    "kit",
    "khp",
    "sync",
    "websocket",
    "collaboration"
  ],
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./openToken": {
        "types": "./dist/openToken.d.ts",
        "import": "./dist/openToken.js"
      }
    }
  },
  "main": "./dist/index.js"
}
