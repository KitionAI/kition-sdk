{
  "name": "@kition/kit-host",
  "version": "0.5.2",
  "description": "The host's side of the Kit UI protocol: mount an embedded kit UI in an iframe and serve its file calls.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@kition/kit-ui-protocol": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KitionAI/kition-sdk.git",
    "directory": "packages/kit-host"
  },
  "homepage": "https://github.com/KitionAI/kition-sdk/tree/main/packages/kit-host#readme",
  "bugs": {
    "url": "https://github.com/KitionAI/kition-sdk/issues"
  },
  "keywords": [
    "kition",
    "kit",
    "khp",
    "kit-ui",
    "iframe",
    "host"
  ],
  "types": "./dist/types/src/index.d.ts",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/types/src/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "node ../../tools/build-package.mjs",
    "prepack": "pnpm run build"
  }
}
