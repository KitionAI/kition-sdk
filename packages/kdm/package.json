{
  "name": "@kition/kdm",
  "version": "0.5.2",
  "description": "Kit Data Model reader for TypeScript hosts and pages: loads a document's content or snapshot, follows the changes the kition-kdm crate exports, and reads its objects.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../tools/build-package.mjs",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KitionAI/kition-sdk.git",
    "directory": "packages/kdm"
  },
  "homepage": "https://github.com/KitionAI/kition-sdk/tree/main/packages/kdm#readme",
  "bugs": {
    "url": "https://github.com/KitionAI/kition-sdk/issues"
  },
  "keywords": [
    "kition",
    "kit",
    "khp",
    "kdm",
    "document-model"
  ],
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "main": "./dist/index.js"
}
