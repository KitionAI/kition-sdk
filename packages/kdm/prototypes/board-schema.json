{
  "kdm": 1,
  "kit": "kit.board",
  "schemaVersion": 1,
  "root": "Board",
  "types": {
    "Board": { "fields": { "name": { "kind": "string" }, "pages": { "kind": "list", "of": "Page" } } },
    "Page": { "fields": { "name": { "kind": "string" }, "elements": { "kind": "list", "of": "Element" } } },
    "Element": {
      "fields": {
        "kind": { "kind": "enum", "values": ["rect", "ellipse", "text", "arrow"] },
        "x": { "kind": "number" },
        "y": { "kind": "number" },
        "w": { "kind": "number" },
        "h": { "kind": "number" },
        "rotation": { "kind": "number", "optional": true },
        "fill": { "kind": "string", "optional": true },
        "stroke": { "kind": "string", "optional": true },
        "text": { "kind": "text" }
      }
    }
  }
}
