{
  "name": "@kition/extensions",
  "version": "0.5.2",
  "description": "The Kition extension host (KitExtensions 1.0): extension.json manifests, a sandboxed worker per extension on an opaque origin with declared permissions, and the object model gated by them.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./sandbox.html": "./sandbox/sandbox.html",
    "./panel.html": "./sandbox/panel.html"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:runtime": "node scripts/build-runtime.mjs",
    "build": "node ../../tools/build-package.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@kition/kdm": "workspace:*",
    "@kition/script": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KitionAI/kition-sdk.git",
    "directory": "packages/extensions"
  },
  "homepage": "https://github.com/KitionAI/kition-sdk/tree/main/packages/extensions#readme",
  "bugs": {
    "url": "https://github.com/KitionAI/kition-sdk/issues"
  },
  "keywords": [
    "kition",
    "kit",
    "khp",
    "extensions",
    "sandbox",
    "plugins",
    "object-model"
  ],
  "types": "./dist/types/src/index.d.ts",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/types/src/index.d.ts",
        "import": "./dist/index.js"
      },
      "./runtime": {
        "types": "./dist/types/src/runtime/index.d.ts",
        "import": "./dist/runtime.js"
      },
      "./sandbox.html": "./dist/sandbox.html",
      "./panel.html": "./dist/panel.html"
    }
  },
  "main": "./dist/index.js"
}
